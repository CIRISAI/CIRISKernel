cd: CD1 device 1 acks b2,b3; device 2 concurrently acks t
cd:    heads=('b1',) holders=('h1', 'h2', 'h3', 'h4', 'h5') void=() grants={}
cd: CD2 device 2 acks t1, t (two rows), device 1 b2,b3
cd:    heads=('b1',) holders=('h1', 'h2', 'h3', 'h4', 'h5') void=() grants={}
cd: CD3 a new reader whose only device acks t
cd:    heads=('t',) holders=('X', 'h1', 'h2', 'h3') void=() grants={}
cd: CD4 CD1 + a settler at b1 toward b2 by h4,h5
cd:    heads=('b1',) holders=('h1', 'h2', 'h3', 'h4', 'h5') void=() grants={}
cd: CD5 CD1 + a settler at b1 toward t1 by h1,h2 (removed at b2, a say at b1)
cd:    heads=('b1',) holders=('h1', 'h2', 'h3', 'h4', 'h5') void=() grants={}
cd: CD6 both settlers
cd:    heads=('b1',) holders=('h1', 'h2', 'h3', 'h4', 'h5') void=() grants={}
rb: RB0 honest history to b4 (7 holders); reader acked b2,b3,b4
rb:    heads=('b4',) holders=('h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9') void=() grants={}
rb: RB1 + t1 (h1,h2,h3 at b1, keeps h1,h2)
rb:    heads=('b4',) holders=('h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9') void=() grants={}
