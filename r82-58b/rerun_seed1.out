rb:    heads=('b4',) holders=('h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9') void=() grants={'gh': (True, None)}
rb: RB2 honest join (b4, t1) by h4..h9
rb:    heads=('b4',) holders=('h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9') void=() grants={}
rb: RB2b the same join with h1 signing too
rb:    heads=('j2',) holders=('h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9') void=() grants={}
st: ST0 control: reader acked b2, b3 (s0 exists)
st:    heads=('b3',) holders=('h3', 'h4', 'h5', 'h6') void=() grants={}
st: ST1 reader acked s0 first, then b2, then b3
st:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={}
st: ST2 a new reader acks b3 only
st:    heads=('b3',) holders=('h3', 'h4', 'h5', 'h6') void=() grants={}
st: ST3 a reader with no acks (anchor only)
st:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={}
st: ST4 ST1 + a rule-3 settler at b0 naming b1 and s0, by h3
st:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={}
st: ST5 the same settler by h3 and h1
st:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={}
st: ST1g an honest grant on b3, reader ST1
st:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={'gh': (False, 'grant_voices_not_in_force')}
ao: AO0 s0 concludes; reader acked b2 then s0
ao:    heads=('b2',) holders=('h3', 'h4', 'h5') void=() grants={}
ao: AO1 reader acked s0 then b2 (s0 delivered first)
ao:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={}
ao: AO2 reader acked b1 then s0 then b2
ao:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={}
ao: AO3 a new reader acked s0 only
ao:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={}
ao: AO3g + h1,h2 grant on s0, reader acked s0 then b2
ao:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={'gx': (False, 'grant_voices_not_in_force')}
ao: AO1h honest grant on b2 by h3,h4; reader acked s0 then b2
ao:    heads=('b0',) holders=('h1', 'h2', 'h3') void=() grants={'gh': (False, 'grant_voices_not_in_force')}
