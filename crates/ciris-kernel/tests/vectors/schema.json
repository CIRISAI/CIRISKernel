{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CIRISAI/CIRISKernel/crates/ciris-kernel/tests/vectors/schema.json",
  "title": "ciris-kernel neutral case form",
  "description": "The neutral case form of VECTORS.md: a case names keys by seed, rows and objects by label, statements in mint order, and questions with expected answers carried through untouched. Rules this schema cannot state are marked (prose) in VECTORS.md and checked by the minter.",
  "type": "object",
  "required": [
    "form",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "form": {
      "const": "ciris-kernel-cases/1"
    },
    "constitution": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]*$"
    },
    "ms": {
      "type": "object",
      "required": [
        "$ms"
      ],
      "additionalProperties": false,
      "properties": {
        "$ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "source",
        "keys",
        "statements",
        "reader",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        },
        "source": {
          "type": "object",
          "required": [
            "check",
            "case"
          ],
          "additionalProperties": false,
          "properties": {
            "check": {
              "type": "string",
              "description": "A path in this repository: a model check or a test fixture."
            },
            "case": {
              "type": "string",
              "description": "The case's own name there."
            }
          }
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "rows": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/row"
          }
        },
        "objects": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/object"
          }
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/statement"
          }
        },
        "delivery_order": {
          "type": "array",
          "description": "Every statement label once, in the order the reader receives them. Absent: mint order.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reader": {
          "$ref": "#/$defs/reader"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "key": {
      "type": "object",
      "required": [
        "name",
        "seed",
        "identity",
        "identity_type",
        "kind",
        "records"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 155,
          "description": "Key n is the seed pair [n; 32] and [n + 100; 32] (Verify's convention)."
        },
        "identity": {
          "$ref": "#/$defs/name",
          "description": "The key whose identity reference is this key's iss."
        },
        "identity_type": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user",
              "node",
              "agent",
              "accord_holder"
            ]
          }
        },
        "kind": {
          "enum": [
            "genesis",
            "rotated",
            "occurrence",
            "room"
          ]
        },
        "room": {
          "$ref": "#/$defs/name",
          "description": "For kind room: the placement group the key is made for."
        },
        "records": {
          "oneOf": [
            {
              "const": "minter_supplies"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/name"
              },
              "description": "Labels of key:record rows."
            }
          ]
        },
        "supplied_until": {
          "$ref": "#/$defs/ms"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "room"
          }
        }
      },
      "then": {
        "required": [
          "room"
        ]
      },
      "else": {
        "not": {
          "required": [
            "room"
          ]
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "founding"
                ],
                "additionalProperties": false,
                "properties": {
                  "founding": {
                    "type": "object",
                    "required": [
                      "group_kind",
                      "first_members",
                      "founded_at",
                      "nonce"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "group_kind": {
                        "enum": [
                          "family",
                          "community"
                        ]
                      },
                      "first_members": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "$ref": "#/$defs/name"
                        }
                      },
                      "founded_at": {
                        "$ref": "#/$defs/ms"
                      },
                      "nonce": {
                        "$ref": "#/$defs/bytes"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^group-[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "ref": {
      "type": "object",
      "required": [
        "label",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/name"
        },
        "id": {
          "enum": [
            "row",
            "object"
          ],
          "description": "Which id is meant: the row id or an object id. refs never names a statement id."
        }
      }
    },
    "refset": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "refone": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "head": {
          "$ref": "#/$defs/ref"
        },
        "further_heads": {
          "$ref": "#/$defs/refset"
        },
        "prev": {
          "$ref": "#/$defs/ref"
        },
        "further_prev": {
          "$ref": "#/$defs/refset"
        },
        "answers": {
          "$ref": "#/$defs/ref"
        },
        "target": {
          "$ref": "#/$defs/ref"
        },
        "trusted_through": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "also": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "ack": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/ref"
              }
            },
            "cites": {
              "$ref": "#/$defs/refset"
            },
            "under": {
              "$ref": "#/$defs/refone"
            },
            "stands_on": {
              "$ref": "#/$defs/refone"
            },
            "voice": {
              "$ref": "#/$defs/refone"
            }
          }
        }
      }
    },
    "bytes": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "$bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "$bytes": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$fill"
          ],
          "additionalProperties": false,
          "properties": {
            "$fill": {
              "type": "object",
              "required": [
                "byte",
                "len"
              ],
              "additionalProperties": false,
              "properties": {
                "byte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "len": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "keyname1": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "$identity": {
          "$ref": "#/$defs/name"
        },
        "$key_ref": {
          "$ref": "#/$defs/name"
        },
        "$kid": {
          "$ref": "#/$defs/name"
        },
        "$cose_key": {
          "$ref": "#/$defs/name"
        },
        "$group": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "value": {
      "description": "A typed payload value (VECTORS.md, Typed values).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/ms"
        },
        {
          "$ref": "#/$defs/bytes"
        },
        {
          "$ref": "#/$defs/keyname1"
        },
        {
          "type": "object",
          "required": [
            "$xwing_pubkey"
          ],
          "additionalProperties": false,
          "properties": {
            "$xwing_pubkey": {
              "type": "object",
              "required": [
                "seed"
              ],
              "additionalProperties": false,
              "properties": {
                "seed": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$seat_commitment"
          ],
          "additionalProperties": false,
          "properties": {
            "$seat_commitment": {
              "type": "object",
              "required": [
                "room",
                "room_key",
                "person",
                "nonce"
              ],
              "additionalProperties": false,
              "properties": {
                "room": {
                  "$ref": "#/$defs/name"
                },
                "room_key": {
                  "$ref": "#/$defs/name"
                },
                "person": {
                  "$ref": "#/$defs/name"
                },
                "nonce": {
                  "$ref": "#/$defs/bytes"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$decimal"
          ],
          "additionalProperties": false,
          "properties": {
            "$decimal": {
              "type": "object",
              "required": [
                "exponent",
                "mantissa"
              ],
              "additionalProperties": false,
              "properties": {
                "exponent": {
                  "type": "integer",
                  "maximum": -1
                },
                "mantissa": {
                  "type": "integer"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$set"
          ],
          "additionalProperties": false,
          "properties": {
            "$set": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$seq"
          ],
          "additionalProperties": false,
          "properties": {
            "$seq": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$tuple"
          ],
          "additionalProperties": false,
          "properties": {
            "$tuple": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$digest"
          ],
          "additionalProperties": false,
          "properties": {
            "$digest": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$commitment"
          ],
          "additionalProperties": false,
          "properties": {
            "$commitment": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        {
          "type": "object",
          "description": "A map with text keys: no key begins with $.",
          "propertyNames": {
            "pattern": "^[^$]"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "asserted_at"
      ],
      "propertyNames": {
        "not": {
          "enum": [
            "author",
            "refs",
            "dimension"
          ]
        },
        "pattern": "^[^$]"
      },
      "properties": {
        "asserted_at": {
          "$ref": "#/$defs/ms"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "row": {
      "type": "object",
      "required": [
        "row_type",
        "family",
        "sub",
        "authorship",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "row_type": {
          "enum": [
            "scores",
            "delegates_to",
            "supersedes",
            "withdraws",
            "recants"
          ]
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9_.][a-z0-9_.-]*(:[a-z0-9_.][a-z0-9_.-]*)*$"
        },
        "dimension": {
          "type": "string",
          "description": "The full dimension, leaf and version; {thumb:NAME} and {group:NAME} are filled by the minter."
        },
        "sub": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": false,
              "properties": {
                "$identity": {
                  "$ref": "#/$defs/name"
                },
                "$key_ref": {
                  "$ref": "#/$defs/name"
                },
                "$group": {
                  "$ref": "#/$defs/name"
                }
              }
            }
          ]
        },
        "authorship": {
          "enum": [
            "authored",
            "counted"
          ]
        },
        "author": {
          "$ref": "#/$defs/name"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authorship": {
                "const": "authored"
              }
            }
          },
          "then": {
            "required": [
              "author"
            ]
          },
          "else": {
            "not": {
              "required": [
                "author"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "row_type": {
                "enum": [
                  "withdraws",
                  "recants"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "dimension"
              ]
            }
          }
        }
      ]
    },
    "object": {
      "type": "object",
      "required": [
        "typ",
        "author",
        "iat",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "typ": {
          "enum": [
            "ceg-genesis-bundle/2",
            "ceg-revocation-snapshot/2"
          ],
          "description": "Every object's CWT claims are a closed set: iss, -70003 = 2, optional iat, optional sub (Verify v23.7.0). A genesis bundle's sub equals its payload's family_key_id, written by the minter (ruled)."
        },
        "author": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/name"
            }
          ]
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds; for a bundle floor(asserted_at / 1000)."
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "author",
                "refs"
              ]
            },
            "pattern": "^[^$]"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "refs": {
          "$ref": "#/$defs/refs"
        },
        "sub": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "$identity"
              ],
              "additionalProperties": false,
              "properties": {
                "$identity": {
                  "$ref": "#/$defs/name"
                }
              }
            }
          ],
          "description": "A snapshot's or boot manifest's sub, written only where stated; never for a genesis bundle."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "typ": {
                "const": "ceg-genesis-bundle/2"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "sub"
              ]
            }
          }
        }
      ]
    },
    "fault": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wrong_signer"
            },
            "key": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "half"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bad_signature_half"
            },
            "half": {
              "enum": [
                "ml_dsa_65",
                "ed25519"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "missing_member"
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unsorted_set"
            },
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path",
            "how"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "second_encoding"
            },
            "path": {
              "type": "string"
            },
            "how": {
              "enum": [
                "non_shortest_int",
                "indefinite_length",
                "unsorted_map_keys"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "iat"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "iat_mismatch"
            },
            "iat": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "statement": {
      "type": "object",
      "required": [
        "of",
        "key",
        "as"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "of": {
          "$ref": "#/$defs/name",
          "description": "The row or object label the statement signs."
        },
        "key": {
          "$ref": "#/$defs/name"
        },
        "as": {
          "enum": [
            "self",
            "rotated",
            "occurrence",
            "room"
          ]
        },
        "first_held_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Ms: when the reader first held this statement. Absent: held from the start."
        },
        "fault": {
          "$ref": "#/$defs/fault"
        }
      }
    },
    "reader": {
      "type": "object",
      "required": [
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/name"
            }
          ]
        },
        "key": {
          "$ref": "#/$defs/name"
        },
        "anchor": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "bundle"
              ],
              "additionalProperties": false,
              "properties": {
                "bundle": {
                  "$ref": "#/$defs/ref"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "holders"
              ],
              "additionalProperties": false,
              "properties": {
                "holders": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/name"
                  }
                }
              }
            }
          ]
        },
        "trust_store": {
          "type": "object",
          "required": [
            "attestation_roots"
          ],
          "additionalProperties": false,
          "properties": {
            "attestation_roots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "object",
          "required": [
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "statement"
          ],
